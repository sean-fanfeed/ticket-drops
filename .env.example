# Ticket-drop tracker secrets. Copy to .env and fill in. NEVER commit .env.

# Required. https://developer.ticketmaster.com -> My Apps -> Consumer Key
TICKETMASTER_API_KEY=

# Required. Push topic. Anyone who knows this string can read your alerts,
# so keep the random suffix.
NTFY_TOPIC=sean-tickets-REPLACE_ME

# Optional. Turns on real resale comps + popularity instead of the genre table.
# https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Optional. Eventbrite retired public event search in 2019, so this currently
# does nothing - wired up in case they bring it back.
EVENTBRITE_TOKEN=

# Public-by-design: this topic is embedded in the published page so the
# phone can push watchlist edits back to the tracker. Separate from NTFY_TOPIC
# so your alert feed stays private.
WATCHLIST_TOPIC=sean-watchlist-REPLACE_ME
